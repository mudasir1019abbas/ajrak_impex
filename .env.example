# Copy this file to .env.local and fill in the values.

# MySQL database (created in hPanel on Hostinger)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Session signing secret: 32+ random characters (openssl rand -base64 48).
# Changing it logs everyone out.
JWT_SECRET=ajrak

# Comma-separated numeric IDs of existing users allowed to use /admin.
# Find IDs in the MySQL users table; never use account email alone for admin access.
ADMIN_USER_IDS=3

# Public URL of the site, used for social-sharing metadata.
# Set it before building for production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
